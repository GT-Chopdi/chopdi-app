# Copy to `.env` for local development. Never commit the real `.env`.
# Values are validated at startup by src/common/config/env.validation.ts.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Neon (PostgreSQL) connection string. Get it from the Neon dashboard.
# Include `?sslmode=require` for Neon. Example:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=NEON_DATABASE_URL
