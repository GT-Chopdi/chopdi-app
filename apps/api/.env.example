# Copy to `.env` for local development. Never commit the real `.env`.
# Values are validated at startup by src/common/config/env.validation.ts —
# the process refuses to boot if anything here is missing or malformed.

# ---------------------------------------------------------------- runtime ---

# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# --------------------------------------------------------------- database ---

# Neon POOLED endpoint — used by the running application.
# This is the host containing `-pooler`. Neon caps direct connections per
# compute, and the app will exhaust them without the pooler.
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=NEON_POOLED_URL

# Neon DIRECT endpoint — used ONLY by `prisma migrate`.
# Migrations need session-scoped state (DDL, advisory locks) that the
# transaction-mode pooler cannot carry. Same host as above, without `-pooler`.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=NEON_DIRECT_URL

# Which Prisma driver adapter to use: pg | neon
#
#   pg   — node-postgres over TCP. Use for local development and any
#          long-lived process (Render, Cloud Run, a VPS).
#   neon — Neon's serverless WebSocket driver. Use on Vercel, where each
#          function instance is ephemeral and TCP pools would accumulate.
#
# IMPORTANT: `neon` only works against a real Neon endpoint. It speaks Neon's
# WebSocket protocol, which a plain local Postgres does not understand — the
# app will start and then fail every query with DB_UNAVAILABLE. Always use
# `pg` locally, even when the deployment target is Vercel.
DATABASE_DRIVER=pg

# ----------------------------------------------------------------- tokens ---

# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use DIFFERENT values for access and refresh, and different values per
# environment. Rotating these invalidates every issued token.
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET

# Access token lifetime (ms/vercel style duration string)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# -------------------------------------------------------------------- OTP ---

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --------------------------------------------------------------- dev mode ---

# When true, ANY phone number authenticates with AUTH_DEV_OTP and no SMS is
# sent. Everything downstream is real — real user row, real device, real
# tokens, real sync — so the full flow is exercised without an SMS provider.
#
# The process REFUSES TO BOOT if this is true while NODE_ENV=production.
# Use this until DLT registration clears, then set it to false and the SMS
# adapter takes over with no other change.
AUTH_DEV_MODE=true

# The fixed code accepted while dev mode is on.
AUTH_DEV_OTP=123456

# Shared secret required on auth requests while dev mode is on (min 16 chars).
# Staging is internet-reachable — without this, anyone who finds the URL can
# sign in as any phone number. Required whenever AUTH_DEV_MODE=true.
AUTH_DEV_KEY=CHANGE_ME_MIN_16_CHARS

# ------------------------------------------------------------------- sync ---

# Maximum operations in one push batch
SYNC_MAX_BATCH_SIZE=200

# Hard ceiling on pull page size, regardless of what the client requests
SYNC_MAX_PULL_LIMIT=500

# JSON body limit. The framework default (100 KB) is too small for a full
# 200-operation batch, so this is set explicitly.
SYNC_BODY_LIMIT=1mb
