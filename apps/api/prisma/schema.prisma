// Prisma schema for the Chopdi API.
//
// Prisma 7 uses the `prisma-client` generator (no Rust engine) together with a
// driver adapter. The connection URL lives in `prisma.config.ts`, not here.
//
// Phase 0 (this file): identity and authentication.
// Phase 1 adds the domain tables (customer, ledger_entry) and the sync
// infrastructure (sync_operation, sync_change_log, app_user.change_seq).
//
// Conventions:
//   - Primary keys are UUIDs. Domain rows are keyed by client-generated
//     UUIDv7 so a row created offline has a permanent identity at birth;
//     auth rows are server-generated.
//   - Postgres names are snake_case via @map/@@map; Prisma names are camelCase.
//   - Value constraints (status enums, bounds) are CHECK constraints applied in
//     migration SQL, not just DTO validation — no code path can bypass them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person who uses Chopdi.
///
/// Phone number is a *credential*, not the key: `id` is what every other table
/// references, so changing a phone number is a single-column update rather than
/// a re-parenting exercise.
model AppUser {
  id          String  @id @db.Uuid
  phoneE164   String  @unique @map("phone_e164")
  displayName String? @map("display_name")

  /// active | suspended — enforced by CHECK constraint.
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Per-tenant monotonic sync cursor — the single source of ordering truth.
  ///
  /// Assigned inside the same transaction as the mutation, via
  /// `UPDATE app_user SET change_seq = change_seq + 1 ... RETURNING`. That
  /// statement takes a row-exclusive lock held until commit, so two concurrent
  /// writes for one user serialise here: the second gets a higher sequence AND
  /// commits later. Sequence order therefore matches commit-visibility order,
  /// which is exactly what a cursor needs and what neither a timestamp nor a
  /// plain BIGSERIAL can promise — both allocate before commit, so a reader can
  /// skip a row that committed late and never see it again.
  ///
  /// Different users take different row locks, so cross-tenant throughput is
  /// unaffected.
  changeSeq BigInt @default(0) @map("change_seq")

  devices        Device[]
  refreshTokens  RefreshToken[]
  chopdis        Chopdi[]
  customers      Customer[]
  lenders        Lender[]
  ledgerEntries  LedgerEntry[]
  syncOperations SyncOperation[]
  changeLog      SyncChangeLog[]
  partyMerges    PartyMerge[]

  @@map("app_user")
}

/// One installation of the app, belonging to one user.
///
/// `installId` is generated by the client and kept in secure storage so it
/// survives a local database wipe. The surrogate `id` is what the JWT `did`
/// claim and the `X-Device-Id` header carry, which keeps those stable even if
/// a second user signs in on the same handset — hence the composite unique on
/// (userId, installId) rather than making installId the primary key.
model Device {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  installId String @map("install_id") @db.Uuid

  /// android | ios — enforced by CHECK constraint.
  platform   String
  appVersion String @map("app_version")

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  /// Set when the user revokes this device. The auth guard rejects any request
  /// carrying a revoked device, which is what makes "log out my lost phone"
  /// meaningful.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  /// Also serves lookups by userId alone (leading column).
  @@unique([userId, installId])
  @@map("device")
}

/// A pending one-time-password verification.
///
/// The code is never stored or logged in plaintext — only its Argon2id hash.
/// `attempts` is incremented on every failed verification and the challenge is
/// burned once it reaches `maxAttempts`, which is what bounds brute force.
model OtpChallenge {
  id        String @id @db.Uuid
  phoneE164 String @map("phone_e164")
  codeHash  String @map("code_hash")

  attempts    Int @default(0)
  maxAttempts Int @map("max_attempts")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_challenge")
}

/// A refresh token, stored as a SHA-256 hash so a database read yields nothing
/// usable.
///
/// Tokens rotate on every use: redeeming one marks it `usedAt` and issues a
/// successor in the same `familyId`. Presenting an already-used token means two
/// parties hold the lineage — one of them is a thief — so the whole family is
/// revoked rather than just that token.
model RefreshToken {
  id        String @id @db.Uuid
  userId    String @map("user_id") @db.Uuid
  deviceId  String @map("device_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  /// Rotation lineage. Every successor of an original login shares this id.
  familyId String @map("family_id") @db.Uuid

  /// The token this one replaced. Forensic only — deliberately not a foreign
  /// key, so pruning an ancestor never cascades into live tokens.
  parentId String? @map("parent_id") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([deviceId])
  @@map("refresh_token")
}

// ---------------------------------------------------------------------------
// Domain — Phase 1
// ---------------------------------------------------------------------------

/// A ledger book ("chopdi"). A user can keep several, and every customer and
/// lender belongs to one.
///
/// Synced so a user signing in on a new device gets their books back with the
/// same grouping, not one undifferentiated list.
model Chopdi {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  name        String
  description String @default("")

  /// The book every user starts with ("My Chopdi"), created by the server at
  /// sign-in rather than by the app, so two devices can never each make one.
  /// At most one live default per user — a partial unique index in migration
  /// SQL, since Prisma cannot express the WHERE clause.
  isDefault Boolean @default(false) @map("is_default")

  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers Customer[]
  lenders   Lender[]

  @@index([userId])
  @@map("chopdi")
}

/// A borrower in someone's ledger — someone the user *gave* a loan to.
///
/// `id` is a client-generated UUIDv7: the row must have a permanent identity
/// from the moment it is created offline, because a ledger entry may reference
/// it long before either row reaches the server.
model Customer {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Nullable: rows synced before books were synced have no chopdi on the
  /// server until the client backfills it.
  chopdiId String? @map("chopdi_id") @db.Uuid

  name      String
  phoneE164 String? @map("phone_e164")

  /// Matching key for duplicate detection: trimmed, single-spaced, lowercased
  /// name. Server-maintained on every create and update — see party-keys.ts.
  /// Two devices that each created "Ravi" offline produce two ids; this is
  /// what lets the server recognise them as one person.
  nameKey  String @default("") @map("name_key")
  /// Last 10 digits of the phone, or '' when there is none.
  phoneKey String @default("") @map("phone_key")
  notes     String  @default("")

  /// Optimistic-concurrency guard. Server-owned: a client never sends it as
  /// data, only as `expectedVersion` on an update. A mismatch is a conflict,
  /// which is reported rather than silently merged.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Soft delete. Hard deletes are invisible to other devices — the row simply
  /// stops appearing in a pull, with no way to distinguish "deleted" from
  /// "never seen" — and they destroy the audit trail.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chopdi  Chopdi?       @relation(fields: [chopdiId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  // No separate userId index: customer_match_key_idx leads with user_id.
  @@index([chopdiId])
  @@index([userId, nameKey, phoneKey], map: "customer_match_key_idx")
  @@map("customer")
}

/// Someone the user *took* a loan from.
///
/// Its own table, mirroring the client's separate Isar collection, so the two
/// kinds of party can never be confused. Ids are UUIDv7 and never collide with
/// customer ids.
model Lender {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  chopdiId String? @map("chopdi_id") @db.Uuid

  name      String
  phoneE164 String? @map("phone_e164")

  /// Matching key for duplicate detection: trimmed, single-spaced, lowercased
  /// name. Server-maintained on every create and update — see party-keys.ts.
  /// Two devices that each created "Ravi" offline produce two ids; this is
  /// what lets the server recognise them as one person.
  nameKey  String @default("") @map("name_key")
  /// Last 10 digits of the phone, or '' when there is none.
  phoneKey String @default("") @map("phone_key")
  notes     String  @default("")

  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user    AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chopdi  Chopdi?       @relation(fields: [chopdiId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  // No separate userId index: lender_match_key_idx leads with user_id.
  @@index([chopdiId])
  @@index([userId, nameKey, phoneKey], map: "lender_match_key_idx")
  @@map("lender")
}

/// One movement of money: a loan given, or a repayment received.
///
/// Entries are facts, not state. Two devices creating entries offline produce a
/// union rather than a conflict, and balances are derived by folding them — so
/// there is no shared mutable number for two devices to disagree about. That
/// property is what makes offline sync tractable here, and it is why no
/// `balance` column exists on Customer.
model LedgerEntry {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Exactly one of customerId / lenderId is set — enforced by the
  /// `ledger_entry_one_parent` CHECK constraint.
  customerId String? @map("customer_id") @db.Uuid
  lenderId   String? @map("lender_id") @db.Uuid

  /// Money as an integer count of paise — never a float.
  ///
  /// IEEE-754 cannot represent 0.1 exactly; over months of interest accrual the
  /// error compounds and is unauditable. BIGINT also maps to a Dart `int`,
  /// which is exact on mobile, so no conversion layer can silently reintroduce
  /// a double. Always positive: direction carries the sign, which makes a
  /// negative amount structurally unrepresentable.
  amountPaise BigInt @map("amount_paise")

  /// Which way the money moved: gave (out) | received (in).
  /// Enforced by CHECK constraint.
  direction String

  /// Whose ledger this belongs to: lent | borrowed.
  ///
  /// Direction and side are stored separately because they are independent
  /// facts. Borrowing reverses the cash direction — taking a loan is money
  /// *received*, repaying it is money *gave* — so a single combined column
  /// would force every reader to remember that. Splitting them means one
  /// signing rule covers all four cases the client can express.
  ///
  /// Defaults to `lent`: every row that existed before borrowing was added is
  /// a loan the user made.
  ledgerSide String @default("lent") @map("ledger_side")

  /// Interest rate in basis points: 12.5% is 1250. Integer for the same reason
  /// as the amount.
  interestRateBp Int @default(0) @map("interest_rate_bp")

  /// none | simple | compound — enforced by CHECK constraint.
  interestType String @default("none") @map("interest_type")

  /// daily | weekly | monthly | yearly — enforced by CHECK constraint.
  interestFrequency String @default("monthly") @map("interest_frequency")

  /// The business date, deliberately a DATE and not an instant.
  ///
  /// "I lent ₹5,000 on 3 March" is a calendar fact. Storing an instant means a
  /// user in IST who records an entry at 02:00 sees it dated the previous day
  /// wherever it renders in UTC — and interest day-counts must run on calendar
  /// days regardless.
  entryDate DateTime @map("entry_date") @db.Date

  description String @default("")
  paymentMode String @default("") @map("payment_mode")

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Soft delete for a financial record: the row is never removed, so the audit
  /// trail survives and a `create` carrying a voided id collides with the
  /// existing primary key instead of resurrecting it.
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedReason String?   @map("voided_reason")

  /// Device whose push created the entry. Decides which side of a customer
  /// merge an entry belongs to — see MergeService.
  originDeviceId String? @map("origin_device_id") @db.Uuid

  /// Set when the client addressed the entry to a party id that the server
  /// had merged into another (`party_merge.alias_id`). The entry is stored
  /// against the surviving party; this records which copy it came from.
  viaAliasId String? @map("via_alias_id") @db.Uuid

  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lender   Lender?   @relation(fields: [lenderId], references: [id], onDelete: Restrict)

  @@index([customerId, entryDate(sort: Desc)])
  @@index([lenderId, entryDate(sort: Desc)])
  @@index([userId])
  @@index([viaAliasId])
  @@map("ledger_entry")
}

// ---------------------------------------------------------------------------
// Sync infrastructure — Phase 1
// ---------------------------------------------------------------------------

/// The idempotency ledger: every accepted operation, recorded exactly once.
///
/// This exists for one failure that defines mobile sync — the server commits
/// and the response is lost in a tunnel. The client cannot tell that apart from
/// "it never arrived": retry and you duplicate a ₹5,000 loan, don't retry and
/// you lose it. Only the server holds the information to resolve it.
///
/// Written in the *same transaction* as the mutation. Keeping this in Redis
/// instead would break the guarantee at the exact moment it matters: a crash
/// between the two writes could record the key without the row, and the retry
/// would then be told "already applied" for an entry that does not exist.
/// One duplicate customer or lender folded into another.
///
/// Two offline devices can each create the same person under different ids.
/// The second to reach the server is not inserted; instead its id is recorded
/// here as an alias of the first, so every later operation that names it —
/// entries queued in that device's outbox, edits, deletes — lands on the
/// surviving row. Which side's entries stay live is decided by
/// MergeService.settle: the side with more entries wins.
model PartyMerge {
  /// The id the duplicate was created under. Never a row in customer/lender
  /// for live merges; a soft-deleted row for ones made by the cleanup script.
  aliasId String @id @map("alias_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  /// customer | lender
  entity String
  mainId String @map("main_id") @db.Uuid

  /// Device that created the surviving row, and the one that sent the alias.
  /// Null for merges made by the cleanup script.
  mainDeviceId  String? @map("main_device_id") @db.Uuid
  aliasDeviceId String? @map("alias_device_id") @db.Uuid

  /// The duplicate's fields as sent, so they can be applied if it wins.
  aliasSnapshot Json @map("alias_snapshot")

  /// sync | cleanup
  source String @default("sync")

  /// main | alias — whose entries are currently live.
  winner String @default("main")

  mergedAt DateTime @default(now()) @map("merged_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mainId])
  @@index([userId])
  @@map("party_merge")
}

model SyncOperation {
  id       BigInt @id @default(autoincrement())
  userId   String @map("user_id") @db.Uuid
  /// Client-generated UUIDv7, created with the row and never regenerated on
  /// retry. Regenerating it is the single mistake that reintroduces duplicates.
  opId     String @map("op_id") @db.Uuid
  deviceId String @map("device_id") @db.Uuid

  entity   String
  entityId String @map("entity_id") @db.Uuid
  opType   String @map("op_type")

  /// SHA-256 of the canonical payload. Same key with a different payload means
  /// either a client bug reusing keys or an attacker splicing a new amount onto
  /// a known-good key — both rejected rather than applied.
  payloadHash String @map("payload_hash")

  /// applied | duplicate | conflict | rejected
  resultStatus String @map("result_status")

  /// The response replayed verbatim when the same op arrives again.
  resultBody Json @map("result_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Scoped per user, never global. A global unique index would let anyone who
  /// learns a victim's opId submit it first and silently swallow the victim's
  /// real operation — and would leak whether a given key exists at all.
  @@unique([userId, opId])
  @@index([createdAt])
  @@map("sync_operation")
}

/// Append-only change log. Serves three jobs at once: the pull cursor, the
/// audit trail, and conflict forensics.
///
/// Getting all three from one table is why the audit requirement costs a column
/// rather than a subsystem. The application role holds only INSERT and SELECT
/// here — enforced by GRANT in the migration, not by convention — so no code
/// path, bug, or injection can rewrite history.
model SyncChangeLog {
  id     BigInt @id @default(autoincrement())
  userId String @map("user_id") @db.Uuid

  /// Per-user sequence copied from `AppUser.changeSeq`. This, not `id` and not
  /// a timestamp, is the pull cursor. See the note on that column.
  seq BigInt

  entity   String
  entityId String @map("entity_id") @db.Uuid

  /// create | update | void | merge | conflict
  opType String @map("op_type")

  /// Full row after the change.
  snapshot Json

  /// Full row before it. Null on create. This is what makes the log an audit
  /// trail rather than a change feed.
  previous Json?

  deviceId String? @map("device_id") @db.Uuid
  opId     String? @map("op_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Restrict, not Cascade — deliberately.
  ///
  /// Cascading would let `DELETE FROM app_user` quietly destroy the audit
  /// trail, which is the one thing an audit trail must survive. It also could
  /// not work: the append-only trigger refuses to delete recent rows, so the
  /// cascade fails mid-statement with a confusing constraint error.
  ///
  /// Restricting makes account deletion an explicit procedure that has to
  /// decide what happens to the history — anonymise the subject, or archive and
  /// then prune with the trigger disabled. Both are defensible; silently losing
  /// it is not.
  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Also the pull index: (user_id, seq > cursor) ordered by seq.
  @@unique([userId, seq])
  @@map("sync_change_log")
}
