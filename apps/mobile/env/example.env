# Copy to local.env / staging.env / production.env and fill in.
# Those copies are gitignored; this example is not.
#
# Used with:  flutter run --dart-define-from-file=env/staging.env
#
# These values are COMPILED INTO the binary. They cannot be changed after a
# build, which is deliberate: an APK is a file on a device the attacker
# controls, and a runtime-configurable API address would let anyone repoint the
# app at their own server.

# Base URL, INCLUDING the /api suffix.
#
#   Android emulator : http://10.0.2.2:3001/api   (10.0.2.2 = the host machine)
#   iOS simulator    : http://localhost:3001/api
#   Physical device  : http://<your-LAN-IP>:3001/api
#   Deployed         : https://chopdi-app.vercel.app/api
#
# `localhost` inside an installed app means THE PHONE, never your machine — the
# build refuses to start if you point it there.
API_BASE_URL=

# Required only while the server runs with AUTH_DEV_MODE=true, which is how
# staging accepts the fixed OTP. Sent as the X-Dev-Key header.
#
# MUST be empty for production: it gates a bypass that lets anyone sign in as
# any phone number. The app refuses to start if APP_ENV=production and this is
# set.
DEV_KEY=

# development | staging | production
APP_ENV=development
